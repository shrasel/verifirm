# Application Settings
APP_NAME="Company Verification & Enrichment Service"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# User-Agent for SEC EDGAR and Web Fetching (SEC requires Sample Company Name AdminContact@domain.com)
USER_AGENT="CompanyEnrichmentService/1.0 (auditable-pipeline; contact@example.com)"

# Cache & Storage
CACHE_TTL_SECONDS=2592000 # 30 days
REDIS_URL="redis://localhost:6379/0" # Optional: falls back to in-memory/SQLite cache if Redis is absent

# Optional Commercial / Search API Keys (Pluggable: service operates without these!)
SERPAPI_API_KEY=""
OPENCORPORATES_API_KEY=""
PDL_API_KEY=""
APOLLO_API_KEY=""
CRUNCHBASE_API_KEY=""

# Optional LLM API Keys (Falls back to deterministic rule-based grounding if absent)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
