# Application Settings
APP_NAME="Verifirm — Auditable Company Verification & Enrichment Service"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Compliant User-Agent for SEC EDGAR (max 10 req/s policy) and Wikidata APIs
# Replace with your organization name and contact email in production deployments
USER_AGENT="Verifirm/2.0 (Open-Source Corporate Verification Engine; https://github.com/shrasel/verifirm; shrasel@users.noreply.github.com)"
SEC_MAX_REQUESTS_PER_SECOND=10

# Cache & Storage
CACHE_TTL_SECONDS=2592000 # 30 days
REDIS_URL="redis://localhost:6379/0" # Optional: falls back to bounded in-memory LRU cache if Redis is absent

# Optional Search & Registry API Keys (Pluggable: core pipeline operates with zero keys!)
BRAVE_SEARCH_API_KEY=""
SERPAPI_API_KEY=""
COMPANIES_HOUSE_API_KEY=""
OPENCORPORATES_API_KEY=""

# Optional Commercial Vendor Adapters (Treated as secondary vendor evidence, never ground truth)
PDL_API_KEY=""
APOLLO_API_KEY=""
CRUNCHBASE_API_KEY=""

# Optional LLM API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
